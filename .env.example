REPOSITORY_EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
REPOSITORY_EMBEDDING_DIMENSION=768
```env
# ============================================================
# AdaptiveOps
# ============================================================

APP_NAME=AdaptiveOps


# ============================================================
# Observability
# ============================================================

# Options:
#   mock
#   azure
OBSERVABILITY_MODE=mock

OBSERVATION_WINDOW_MINUTES=10


# ============================================================
# Repository
# ============================================================

# Path to the repository that AdaptiveOps should analyze.
#
# Windows example:
# REPOSITORY_PATH=C:\Users\vansh\projects\my-repository
#
# Linux/macOS example:
# REPOSITORY_PATH=/home/vansh/projects/my-repository
#
# Leave empty if the repository path will be supplied
# programmatically.
REPOSITORY_PATH=


# Maximum repository files to process
REPOSITORY_MAX_FILES=200

# Maximum size of an individual source file in KB
REPOSITORY_MAX_FILE_SIZE_KB=256

# Maximum number of lexical search results
REPOSITORY_MAX_SEARCH_RESULTS=50

# Call graph traversal depth
REPOSITORY_CALL_GRAPH_DEPTH=2

# Maximum files included when building investigation context
REPOSITORY_MAX_CONTEXT_FILES=10

# Maximum symbols included in investigation context
REPOSITORY_MAX_CONTEXT_SYMBOLS=20

# Maximum lines retained for a single symbol
REPOSITORY_MAX_LINES_PER_SYMBOL=150


# ============================================================
# Semantic Repository Search
# ============================================================

# Enable Phase 2 semantic repository search
REPOSITORY_ENABLE_SEMANTIC_SEARCH=true

# Code-specific embedding model
REPOSITORY_EMBEDDING_MODEL=jinaai/jina-embeddings-v2-base-code

# Dimension produced by the embedding model
REPOSITORY_EMBEDDING_DIMENSION=768

# Number of source-code lines in one chunk
REPOSITORY_CHUNK_LINES=120

# Number of overlapping lines between chunks
REPOSITORY_CHUNK_OVERLAP=20

# Number of semantic candidates retrieved from Qdrant
REPOSITORY_SEMANTIC_TOP_K=20

# Embedding generation batch size
REPOSITORY_EMBEDDING_BATCH_SIZE=16

# Maximum sequence length sent to the embedding model
REPOSITORY_EMBEDDING_MAX_SEQ_LENGTH=2048


# ============================================================
# Qdrant
# ============================================================

# Local Qdrant instance
QDRANT_URL=http://localhost:6333

# Leave empty for local Qdrant without authentication
QDRANT_API_KEY=

# Collection containing repository code vectors
QDRANT_COLLECTION=adaptiveops_code

# Qdrant request timeout in seconds
QDRANT_TIMEOUT=60


# ============================================================
# Azure Application Insights
# ============================================================

AZURE_APPLICATION_INSIGHTS_RESOURCE_ID=

AZURE_TENANT_ID=

AZURE_CLIENT_ID=

AZURE_CLIENT_SECRET=


# ============================================================
# Groq
# ============================================================

# Keep these if parts of the existing application still use Groq.
GROQ_API_KEY=

GROQ_MODEL=qwen/qwen3.6-27b

GROQ_TEMPERATURE=0.0


# ============================================================
# MAQ LLM
# ============================================================

MAQ_API_KEY=

# Your Settings class currently has these defaults:
# MAQ_BASE_URL=https://llm.maqsoftware.net/v1
# MAQ_MODEL=muse-glimmer-30b
# MAQ_TEMPERATURE=0.0

# Uncomment these if you want to override the defaults:
# MAQ_BASE_URL=https://llm.maqsoftware.net/v1
# MAQ_MODEL=muse-glimmer-30b
# MAQ_TEMPERATURE=0.0
```
